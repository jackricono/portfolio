---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Resume — Jack Riconosciuto">
  <div class="container prose page-shell resume-page">
    <div class="eyebrow">Resume</div>
    <h1>Jack Riconosciuto</h1>
    <p class="lede">Computer Science · Systems · Scientific Computing</p>

    <div class="resume-contact">
      <a href="mailto:jackricono@gmail.com">jackricono@gmail.com</a>
      <a href="https://github.com/jackricono">github.com/jackricono</a>
      <a href="https://www.linkedin.com/in/jack-riconosciuto-814595337">LinkedIn</a>
    </div>

    <div class="resume-actions">
      <a class="text-link" href="/resume.pdf" target="_blank" rel="noopener">Open PDF ↗</a>
      <a class="text-link" href="/resume.pdf" download>Download PDF ↓</a>
    </div>

    <figure class="resume-preview">
      <a class="resume-paper" href="/resume.pdf" target="_blank" rel="noopener" aria-label="Open Jack Riconosciuto's resume PDF">
        <img src="/images/resume-preview.png" alt="Preview of Jack Riconosciuto's resume" />
      </a>
      <figcaption>Resume · PDF preview · Click the page to open the full document</figcaption>
    </figure>
  </div>
</BaseLayout>
