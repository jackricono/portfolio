---
import BaseLayout from '../layouts/BaseLayout.astro';
const projects = [
  { number:'01', href:'/projects/nvme-driver', title:'Kernel-Space NVMe Driver', type:'Systems / C / OS', text:'A focused NVMe 1.4 implementation for QEMU, followed by kernel integration and validation beneath a filesystem and memory-paging system.' },
  { number:'02', href:'/projects/transcriptomics', title:'C3 → CAM Transcriptomics', type:'Scientific Computing / Bioinformatics', text:'A plant-science project combining low-cost CO₂ sensing, Nanopore RNA sequencing, HPC bioinformatics, and functional annotation.' },
  { number:'03', href:'/projects/observatory', title:'Observatory Computing Network', type:'Infrastructure / FreeBSD / Networking', text:'A locally managed computing and storage system for an astronomy observatory, built around repurposed hardware and large astrophotography datasets.' },
];
---
<BaseLayout title="Jack Riconosciuto — Computer Science, Systems & Scientific Computing">
  <div class="container">
    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow">Computer Science · Systems · Scientific Computing</div>
        <h1>I build systems that have to work in the real world.</h1>
        <p class="lede">I’m Jack Riconosciuto, a computer science student building low-level systems, scientific computing pipelines, and infrastructure that connects software to the physical world.</p>
        <div class="actions">
          <a class="button primary" href="/projects">View projects <span>→</span></a>
          <a class="button" href="/resume">Resume</a>
          <a class="button" href="mailto:jackricono@gmail.com">Get in touch</a>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/images/jack-riconosciuto.jpg" alt="Jack Riconosciuto" />
      </div>
      <div class="hero-aside" aria-label="Focus areas">
        <div><span>01</span>Low-level systems</div>
        <div><span>02</span>Scientific computing</div>
        <div><span>03</span>Real-world infrastructure</div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div><div class="eyebrow">Selected work</div><h2>Projects</h2></div><div class="section-note">Engineering case studies, not just repositories.</div></div>
      <div class="grid">
        {projects.map((project) => <a class="card" href={project.href}>
          <div>
            <div class="card-top"><span class="project-number">{project.number}</span><span class="eyebrow">{project.type}</span></div>
            <h3>{project.title}</h3>
            <p>{project.text}</p>
          </div>
          <span class="card-link">Read case study <span aria-hidden="true">→</span></span>
        </a>)}
      </div>
    </section>

    <section class="section split-section">
      <div>
        <div class="eyebrow">Approach</div>
        <h2>Build, integrate, validate.</h2>
      </div>
      <div class="prose">
        <p>I’m most interested in projects where the interesting part is not simply writing code, but making the whole system behave correctly: drivers beneath operating-system abstractions, computational pipelines attached to experiments, and infrastructure used by other people.</p>
        <a class="text-link" href="/about">More about me <span>→</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(220px, .75fr);
    gap: 4rem;
    align-items: center;
  }

  .hero-photo {
    justify-self: end;
    width: min(100%, 300px);
  }

  .hero-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border: 1px solid #b9b9b4;
    padding: 7px;
    background: #fff;
    border-radius: 2px;
    filter: saturate(.9);
  }

  .hero-aside {
    grid-column: 1 / -1;
  }

  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-photo {
      justify-self: start;
      width: min(82vw, 360px);
    }

    .hero-aside {
      grid-column: auto;
    }
  }
</style>
